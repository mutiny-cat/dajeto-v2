---
import { Icon } from "astro-icon/components"
import type { ImageMetadata } from "astro"
import type { Libro } from "@data/libros"

export interface Props {
  libro: Libro
  fondo: ImageMetadata | undefined
}

const { libro, fondo } = Astro.props
---

<article id="hero" style={fondo ? `background-image: url(${fondo.src})` : undefined}>
  <a href={`/novela/${libro.id}`}>
    <blockquote>
      <h1>{libro.fraseHero}</h1>
    </blockquote>
    <Icon name="arrow" class="hero-arrow" />
  </a>
</article>

<style>
  article {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-black);
    background-size: cover;
    background-position: center;
    inline-size: 100%;
    border: 1px solid var(--color-border);
    border-radius: 1em;
    transition: border-color 0.3s;
  }

  article::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 1.2em var(--color-green-500);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  article:hover {
    border-color: var(--color-green-500);
  }

  article:hover::after {
    opacity: 1;
  }

  a {
    inline-size: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5em;
    text-decoration: none;
    padding: 8em;
  }

  blockquote {
    text-align: center;
    inline-size: 100%;
  }

  h1 {
    font-style: italic;
    font-weight: 400;
    color: var(--color-white);
    margin: 0;
    transition: text-shadow 0.3s;
  }

  h1::before {
    content: "«";
  }

  h1::after {
    content: "»";
  }

  article:hover h1 {
    text-shadow: 0 0 0.5em var(--color-green-500);
  }

  :global(.hero-arrow) {
    color: var(--color-white);
    inline-size: 4em;
    block-size: 4em;
    transition: color 0.3s, transform 0.3s;
  }

  article:hover :global(.hero-arrow) {
    color: var(--color-green-500);
    transform: scale(1.3) translateX(1.2em);
  }

  @media (width <= 768px) {
    a {
      padding: 4em;
    }

    :global(.hero-arrow) {
      inline-size: 3em;
      block-size: 3em;
    }
  }

  @media (width <= 480px) {
    a {
      padding: 2em;
      gap: 1em;
    }

    :global(.hero-arrow) {
      inline-size: 2.5em;
      block-size: 2.5em;
    }
  }
</style>