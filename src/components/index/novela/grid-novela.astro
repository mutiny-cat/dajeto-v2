---
import CardNovela from "./card-novela.astro"
import type { ImageMetadata } from "astro"
import type { Libro } from "@data/libros"

export interface Props {
  libros: { libro: Libro; fondo: ImageMetadata | undefined; libroImg: ImageMetadata | undefined }[]
}

const { libros } = Astro.props
---

<div class="grid">
  <h2>Novela</h2>
  {libros.map(({ libro, fondo, libroImg }) => (
    <CardNovela libro={libro} fondo={fondo} libroImg={libroImg} />
  ))}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2em;
    background: var(--color-black-soft);
    border: 1px solid var(--color-border);
    border-radius: 0.75em;
    padding: 2em;
  }

  .grid h2 {
    grid-column: 1 / -1;
    margin-block-end: 0.5em;
  }

  @media (width <= 768px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>