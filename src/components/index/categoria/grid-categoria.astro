---
import CardCategoria from "./card-categoria.astro"
import type { ImageMetadata } from "astro"
import type { Libro } from "@data/libros"

export interface Props {
  titulo: string
  libros: { libro: Libro; fondo: ImageMetadata | undefined; libroImg: ImageMetadata | undefined }[]
}

const { titulo, libros } = Astro.props
---

<div class="wrapper">
  <h2>{titulo}</h2>
  <div class="grid">
    {libros.map(({ libro, fondo, libroImg }) => (
      <CardCategoria libro={libro} fondo={fondo} libroImg={libroImg} />
    ))}
  </div>
</div>

<style>
  .wrapper {
    background: var(--categoria-grid-bg, var(--color-black-soft));
    border: 1px solid var(--categoria-grid-border, var(--color-border));
    border-radius: 0.75em /* 12px */;
    padding: 2em /* 32px */;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2em /* 32px */;
  }

  .grid > :global(:last-child:nth-child(odd)) {
    grid-column: 1 / -1;
    --orphan-max-w: 200px;
    --card-dir: row;
    --card-align: stretch;
    --card-justify: center;
    --card-text-align: start;
    --pic-shrink: 0;
    --pic-align: center;
    --div-dir: column;
    --div-justify: space-around;
    --div-w: auto;
    --div-flex: none;
  }

  h2 {
    margin-block-end: 0.5em /* 8px */;
  }

  @media (width <= 480px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .grid > :global(:last-child:nth-child(odd)) {
      grid-column: auto;
      --card-dir: column;
      --card-align: center;
      --card-justify: flex-start;
      --card-text-align: center;
      --pic-shrink: 1;
      --pic-align: auto;
      --div-dir: row;
      --div-justify: space-between;
      --div-w: 100%;
      --div-flex: none;
      --orphan-max-w: none;
    }
  }
</style>