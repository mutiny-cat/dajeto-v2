---
import { Icon } from "astro-icon/components"
import { Picture } from "astro:assets"
import type { ImageMetadata } from "astro"
import type { Libro } from "@data/libros"

export interface Props {
  libro: Libro
  fondo: ImageMetadata | undefined
  libroImg: ImageMetadata | undefined
}

const { libro, fondo, libroImg } = Astro.props
---

<article style={fondo ? `--fondo: url(${fondo.src})` : undefined}>
  <a href={`/novela/${libro.id}`}>
    {libroImg && <Picture src={libroImg} formats={['avif', 'webp']} alt={libro.titulo} width={200} height={300} />}
    <div>
      <h4>{libro.titulo}</h4>
      <Icon name="arrow" class="card-arrow" />
    </div>
  </a>
</article>

<style>
  article {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: 0.75em /* 12px */;
    padding: 1.5em /* 24px */;
    outline: 1px solid transparent;
    transition: outline-color 0.3s;
    overflow: hidden;
  }

  article::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--fondo);
    background-size: cover;
    background-position: center;
    filter: brightness(0.5);
    z-index: 0;
  }

  article::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 1.2em /* 19px */ var(--categoria-hover-glow, var(--color-border-soft));
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
    z-index: 0;
  }

  article:hover {
    outline-color: var(--categoria-hover-glow, var(--color-border-soft));
  }

  article:hover::after {
    opacity: 1;
  }

  article:hover h4 {
    text-shadow: 0 0 0.5em /* 8px */ var(--categoria-hover-glow, var(--color-border-soft));
  }

  a {
    position: relative;
    z-index: 1;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: var(--card-dir, column);
    align-items: var(--card-align, center);
    justify-content: var(--card-justify, flex-start);
    text-align: var(--card-text-align, center);
    gap: 1em /* 16px */;
  }

  picture {
    display: block;
    inline-size: 40%;
    max-inline-size: var(--orphan-max-w, none);
    flex-shrink: var(--pic-shrink, 1);
    align-self: var(--pic-align, auto);
    transition: transform 0.3s;
  }

  article:hover picture {
    transform: scale(1.05);
  }

  img {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  div {
    display: flex;
    flex-direction: var(--div-dir, row);
    justify-content: var(--div-justify, space-between);
    align-items: center;
    inline-size: var(--div-w, 100%);
    max-inline-size: var(--div-max-w, none);
    flex: var(--div-flex, none);
    background: rgb(0 0 0 / 0.5);
    padding: 0.6em /* 10px */ 0.8em /* 13px */;
    border-radius: 0.4em /* 6px */;
  }

  a :global(.card-arrow) {
    inline-size: 2em /* 32px */;
    block-size: 2em /* 32px */;
    display: block;
    color: var(--color-white);
    transition: color 0.3s, transform 0.3s;
  }

  article:hover :global(.card-arrow) {
    color: var(--categoria-hover-glow, var(--color-border-soft));
  }

  h4 {
    transition: text-shadow 0.3s;
  }
</style>