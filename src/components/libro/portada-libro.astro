---
import { Picture } from "astro:assets"
import type { ImageMetadata } from "astro:assets"

export interface Props {
  titulo: string
  portada: ImageMetadata
  sinopsis: string
}

const { titulo, portada, sinopsis } = Astro.props
---

<section class="card">
  <Picture src={portada} formats={['avif', 'webp']} alt={titulo} class="cover" />
  <div class="info">
    <h2>Sinopsis</h2>
    <p>{sinopsis}</p>
  </div>
</section>

<style>
  .card {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2em;
    align-items: start;
    background: var(--color-black-soft);
    border: 1px solid var(--color-border);
    border-radius: 0.75em;
    padding: 1.5em;
  }

  .cover {
    inline-size: 100%;
    block-size: auto;
    border-radius: 0.5em;
  }

  .info h2 {
    font-size: var(--text-h2);
    margin-block-end: 0.5em;
  }

  @media (width <= 768px) {
    .card {
      grid-template-columns: 1fr;
    }
  }
</style>
