---
import { Picture } from "astro:assets"
import type { ImageMetadata } from "astro"

export interface Props {
  titulo: string
  portada: ImageMetadata
  sinopsis: string
}

const { titulo, portada, sinopsis } = Astro.props
---

<section class="card">
  <Picture src={portada} formats={['avif', 'webp']} alt={titulo} class="cover" loading="lazy" />
  <div class="info">
    <h2>Sinopsis</h2>
    <p>{sinopsis}</p>
  </div>
</section>

<style>
  .card {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2em /* 32px */;
    align-items: start;
    background: var(--color-primary-600);
    border: 1px solid var(--color-green-700);
    border-radius: 0.75em /* 12px */;
    padding: 2em /* 32px */;
  }

  .cover {
    inline-size: 100%;
    block-size: auto;
    border-radius: 0.5em /* 8px */;
  }

  .info h2 {
    font-size: var(--text-h2);
    margin-block-end: 0.5em /* 8px */;
  }

  @media (width <= 768px) {
    .card {
      grid-template-columns: 1fr;
      padding: 1.5em /* 24px */;
    }
  }

  @media (width <= 480px) {
    .card {
      padding: 1em /* 16px */;
    }
  }
</style>
