---
import type { EnlaceCompra } from "@data/libros"

export interface Props {
  enlaces: EnlaceCompra[]
}

const { enlaces } = Astro.props
---

<section class="card">
  <h2>Comprar</h2>
  <div class="list">
    {enlaces.map((e) => (
      <a href={e.url} target="_blank" rel="noopener noreferrer" class="item">
        <span class="tienda">{e.tienda}</span>
        <span class="formato">{e.formato}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .card {
    grid-column: span 1;
    background: var(--color-black-soft);
    border: 1px solid var(--color-border);
    border-radius: 0.75em;
    padding: 1.5em;
  }

  h2 {
    font-size: var(--text-h3);
    margin-block-end: 0.75em;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 0.75em;
  }

  .item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75em 1em;
    background: var(--color-gray);
    border-radius: 0.5em;
    color: var(--color-white);
    text-decoration: none;
    transition: background 0.2s;
  }

  .item:hover {
    background: var(--color-gray-dark);
  }

  .tienda {
    font-weight: 600;
  }

  .formato {
    font-size: 0.85em;
    color: var(--color-white-soft);
    text-transform: capitalize;
  }
</style>
