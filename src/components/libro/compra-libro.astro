---
import type { EnlaceCompra } from "@data/libros"

export interface Props {
  enlaces: EnlaceCompra[]
}

const { enlaces } = Astro.props

const grupos = enlaces.reduce((acc, e) => {
  if (!acc[e.formato]) acc[e.formato] = []
  acc[e.formato].push(e)
  return acc
}, {} as Record<string, typeof enlaces>)

const etiquetas: Record<string, string> = {
  "tapa-blanda": "Tapa blanda",
  ebook: "Ebook",
  audiolibro: "Audiolibro",
}
---

<section class="card">
  <h2>Comprar</h2>
  {Object.entries(grupos).map(([formato, items]) => (
    <div class="group">
      <h3>{etiquetas[formato] ?? formato}</h3>
      <div class="list">
        {items.map((e) => (
          <a href={e.url} target="_blank" rel="noopener noreferrer" class="item">
            <span class="tienda">{e.tienda}</span>
          </a>
        ))}
      </div>
    </div>
  ))}
</section>

<style>
  .card {
    grid-column: span 1;
    background: var(--color-green-700);
    border: 1px solid var(--color-primary-600);
    border-radius: 0.75em;
    padding: 1.5em;
  }

  h2 {
    font-size: var(--text-h3);
    margin-block-end: 0.75em;
  }

  .group + .group {
    margin-block-start: 1.25em;
  }

  h3 {
    font-size: var(--text-base);
    margin-block-end: 0.5em;
    color: var(--color-white-soft);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }

  @media (width >= 768px) {
    .list {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .item {
    display: block;
    padding: 0.6em 1em;
    background: var(--color-gray);
    border-radius: 0.5em;
    color: var(--color-white);
    text-decoration: none;
    transition: background 0.2s;
  }

  .item:hover {
    background: var(--color-gray-dark);
  }

  .tienda {
    font-weight: 600;
  }
</style>
