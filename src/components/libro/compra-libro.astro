---
import type { EnlaceCompra } from "@data/libros"
import type { ImageMetadata } from "astro"

export interface Props {
  enlaces: EnlaceCompra[]
}

const { enlaces } = Astro.props

const imagenesTienda = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/tiendas/logo-*.png', { eager: true })

function getImagenTienda(archivo: string): ImageMetadata | undefined {
  const key = `/src/assets/images/tiendas/${archivo}`
  return imagenesTienda[key]?.default
}

const grupos = enlaces.reduce((acc, e) => {
  if (!acc[e.formato]) acc[e.formato] = []
  acc[e.formato].push(e)
  return acc
}, {} as Record<string, typeof enlaces>)

const etiquetas: Record<string, string> = {
  "tapa-blanda": "Tapa blanda",
  ebook: "Ebook",
  audiolibro: "Audiolibro",
}
---

<section class="card">
  <h2>Comprar</h2>
  {Object.entries(grupos).map(([formato, items]) => (
    <div class="group">
      <h3>{etiquetas[formato] ?? formato}</h3>
      <div class="list">
        {items.map((e) => {
          const img = getImagenTienda(e.logo)
          return (
            <a href={e.url} target="_blank" rel="noopener noreferrer" class="item">
              {img && <img src={img.src} alt={e.tienda} class="logo" />}
            </a>
          )
        })}
      </div>
    </div>
  ))}
</section>

<style>
  .card {
    background: var(--color-white);
    border: none;
    border-radius: 0.75em /* 12px */;
    padding: 2em /* 32px */;
    color: var(--color-black);
  }

  @media (width <= 768px) {
    .card {
      padding: 1.5em /* 24px */;
    }
  }

  @media (width <= 480px) {
    .card {
      padding: 1em /* 16px */;
    }
  }

  h2 {
    font-size: var(--text-h3);
    margin-block-end: 0.75em /* 12px */;
  }

  .group + .group {
    margin-block-start: 1.25em /* 20px */;
  }

  h3 {
    font-size: var(--text-base);
    margin-block-end: 0.5em /* 8px */;
    color: var(--color-gray-dark);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 0.5em /* 8px */;
  }

  @media (width >= 768px) {
    .list {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.3em /* 5px */ 0.5em /* 8px */;
    border-radius: 0.5em /* 8px */;
    text-decoration: none;
  }

  .logo {
    display: block;
    block-size: 1.8em /* 29px */;
    inline-size: auto;
    object-fit: contain;
  }
</style>
