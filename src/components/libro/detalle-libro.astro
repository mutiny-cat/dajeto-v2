---
export interface Props {
  paginas?: number
  ano: number
  editorial?: string
}

const { paginas, ano, editorial } = Astro.props
---

<section class="card">
  <h2>Detalles</h2>
  <dl>
    <dt>Idioma</dt>
    <dd>Castellano</dd>
    {paginas && <><dt>Páginas</dt><dd>{paginas}</dd></>}
    <dt>Año</dt>
    <dd>{ano}</dd>
    {editorial && <><dt>Editorial</dt><dd>{editorial}</dd></>}
  </dl>
</section>

<style>
  .card {
    grid-column: span 1;
    background: var(--color-primary-600);
    border: 1px solid var(--color-green-700);
    border-radius: 0.75em;
    padding: 1.5em;
  }

  h2 {
    font-size: var(--text-h3);
    margin-block-end: 0.75em;
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5em 1em;
    margin: 0;
  }

  dt {
    color: var(--color-white-soft);
    font-weight: 600;
  }

  dd {
    margin: 0;
  }
</style>
