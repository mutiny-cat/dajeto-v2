---
import type { ImageMetadata } from "astro:assets"
import type { Libro } from "@data/libros"
import Hero from "./hero-libro.astro"
import Cita from "./cita-libro.astro"
import Portada from "./portada-libro.astro"
import Contenido from "./contenido-libro.astro"
import Info from "./info-libro.astro"
import Compra from "./compra-libro.astro"

export interface Props {
  libro: Libro
  fondo?: ImageMetadata
  portada: ImageMetadata
  libroImg?: ImageMetadata
}

const { libro, fondo, portada, libroImg } = Astro.props
---

<div class="grid">
  <Hero fraseHero={libro.fraseHero} ano={libro.ano} {fondo} {libroImg} />
  {libro.fraseHero && (
    <div class="cita-sinopsis">
      <Cita cita={libro.fraseHero} />
      <div class="portada-wrap">
        <Portada titulo={libro.titulo} {portada} sinopsis={libro.sinopsis} />
      </div>
    </div>
  )}
  {!libro.fraseHero && <div class="full"><Portada titulo={libro.titulo} {portada} sinopsis={libro.sinopsis} /></div>}
  <Contenido contenido={libro.contenido} />
  <Info paginas={libro.paginas} ano={libro.ano} editorial={libro.editorial} isbn={libro.isbn} />
  {libro.enlaces.length > 0 && <Compra enlaces={libro.enlaces} />}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1em;
    padding-block-end: 4em;
  }

  .cita-sinopsis {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 1em;
  }

  .portada-wrap {
    grid-column: 2;
  }

  .full {
    grid-column: 1 / -1;
  }
</style>
