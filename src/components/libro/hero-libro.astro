---
import type { ImageMetadata } from "astro:assets"

export interface Props {
  titulo: string
  ano: number
  fondo?: ImageMetadata
  libroImg?: ImageMetadata
}

const { titulo, ano, fondo, libroImg } = Astro.props
---

<section class="hero">
  {fondo && <img src={fondo.src} alt="" class="bg" />}
  <article class="content">
    <div class="overlay">
      <h1>{titulo}</h1>
      <p class="sub">Daniel Jerez Torns · {ano}</p>
    </div>
    {libroImg && <div class="libro-wrap"><img src={libroImg.src} alt={titulo} class="libro" /></div>}
  </article>
</section>

<style>
  .hero {
    grid-column: 1 / -1;
    position: relative;
    aspect-ratio: 21 / 9;
    border: none;
    border-radius: 0.75em;
    overflow: hidden;
  }

  .bg {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.4) brightness(0.65);
  }

  .content {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    block-size: 100%;
  }

  .overlay {
    padding: 2em;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.85));
    flex: 1;
  }

  .overlay h1 {
    font-size: var(--text-h1);
    margin: 0;
  }

  .sub {
    color: var(--color-white-soft);
    font-size: 1em;
    margin-block-start: 0.5em;
  }

  .libro-wrap {
    align-self: flex-end;
    margin-inline-end: 2em;
    block-size: 100%;
    display: flex;
    align-items: flex-end;
  }

  .libro {
    max-block-size: 80%;
    object-fit: contain;
  }
</style>
