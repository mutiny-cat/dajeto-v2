---
import type { ImageMetadata } from "astro:assets"

export interface Props {
  titulo: string
  ano: number
  fondo?: ImageMetadata
}

const { titulo, ano, fondo } = Astro.props
---

<section class="hero">
  {fondo && <img src={fondo.src} alt="" class="bg" />}
  <div class="overlay">
    <h1>{titulo}</h1>
    <p class="sub">Daniel Jerez Torns · {ano}</p>
  </div>
</section>

<style>
  .hero {
    grid-column: 1 / -1;
    position: relative;
    aspect-ratio: 21 / 9;
    display: flex;
    align-items: flex-end;
    border: none;
    border-radius: 0.75em;
    overflow: hidden;
  }

  .bg {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .overlay {
    position: relative;
    inline-size: 100%;
    padding: 2em;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.85));
  }

  .overlay h1 {
    font-size: var(--text-h1);
    margin: 0;
  }

  .sub {
    color: var(--color-white-soft);
    font-size: 1em;
    margin-block-start: 0.5em;
  }
</style>
