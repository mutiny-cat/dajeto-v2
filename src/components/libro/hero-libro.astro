---
import type { ImageMetadata } from "astro:assets"

export interface Props {
  fraseHero?: string
  ano: number
  fondo?: ImageMetadata
  libroImg?: ImageMetadata
}

const { fraseHero, ano, fondo, libroImg } = Astro.props
---

<section class="hero">
  {fondo && <img src={fondo.src} alt="" class="bg" />}
  <article class="content">
    <div class="overlay">
      {fraseHero && <p class="cita">{fraseHero}</p>}
      <p class="sub">Daniel Jerez · {ano}</p>
    </div>
    {libroImg && <div class="libro-wrap"><img src={libroImg.src} alt="" class="libro" /></div>}
  </article>
</section>

<style>
  .hero {
    grid-column: 1 / -1;
    position: relative;
    aspect-ratio: 21 / 9;
    border: none;
    border-radius: 0.75em;
    overflow: hidden;
  }

  .bg {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.4) brightness(0.65);
  }

  .content {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-evenly;
    block-size: 100%;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.85));
  }

  .overlay {
    padding: 3em 4em;
    flex: 1;
    align-self: center;
  }

  .cita {
    font-size: var(--text-h3);
    font-style: italic;
    line-height: 1.6;
    margin: 0;
    max-inline-size: 32em;
  }

  .cita::before {
    content: "«";
  }

  .cita::after {
    content: "»";
  }

  .sub {
    color: var(--color-white-soft);
    font-size: 1em;
    margin-block-start: 0.75em;
  }

  .libro-wrap {
    align-self: center;
    margin-inline-end: 4em;
    display: flex;
    align-items: center;
    block-size: 60%;
  }

  .libro {
    block-size: 100%;
    object-fit: contain;
  }
</style>
