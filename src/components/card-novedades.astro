---
import { Picture } from "astro:assets"
import type { ImageMetadata } from "astro"
import type { Libro } from "@data/libros"

export interface Props {
  libro: Libro
  portada: ImageMetadata | undefined
}

const { libro, portada } = Astro.props

const categoriaTexto: Record<string, string> = {
  novela: "Novela",
  "novela-corta": "Novela corta",
  "cuento-adolescente": "Cuento",
  "cuento-infantil": "Cuento infantil",
}

function ruta(libro: Libro): string {
  const mapa: Record<string, string> = {
    novela: "novela",
    "novela-corta": "novela-corta",
    "cuento-adolescente": "cuentos/adolescentes",
    "cuento-infantil": "cuentos/infantiles",
  }
  return `/${mapa[libro.categoria]}/${libro.id}`
}
---

<a href={ruta(libro)} class:list={["card", libro.categoriaColor]}>
  {portada && <Picture src={portada} formats={['avif', 'webp']} alt={libro.titulo} class="card-img" width={150} height={225} />}
  <div class="card-body">
    <h3 class="card-titulo">{libro.titulo}</h3>
    <span class="card-meta">{categoriaTexto[libro.categoria]} · {libro.ano}</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 0.5em;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--color-gray);
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .card:hover {
    border-color: var(--color-green-500);
    box-shadow: 0 0 1em var(--color-green-500);
  }

  .novela {
    background: var(--color-novela);
  }

  .novela-corta {
    background: var(--color-novela-corta);
  }

  .cuento-adolescente {
    background: var(--color-cuento-adolescente);
  }

  .cuento-infantil {
    background: var(--color-cuento-infantil);
  }

  .card-img {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 0.4em 0.6em 0.6em;
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    text-align: center;
  }

  .card-titulo {
    font-size: 0.78em;
    font-weight: 700;
    line-height: 1.2;
  }

  .card-meta {
    font-size: 0.65em;
    color: var(--color-white-soft);
    opacity: 0.7;
  }
</style>
