---
import { Icon } from "astro-icon/components"
---

<section id="hero">
  <a href="/novela/el-canto-del-gallo">
    <blockquote>
      <h1>«Cuando el gallo cante, alguien caerá»</h1>
    </blockquote>
    <Icon name="arrow" class="hero-arrow" />
  </a>
</section>

<style>
  section {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-black);
    background-image: url('/assets/fondos/bg-el-canto-del-gallo.jpg');
    background-size: cover;
    background-position: center;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 1em;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  section:hover {
    border-color: var(--color-green-500);
    box-shadow: 0 0 1em var(--color-green-500);
  }

  a {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5em;
    text-decoration: none;
    padding: 8em;
  }

  blockquote {
    text-align: center;
    width: 100%;
  }

  h1 {
    font-style: italic;
    font-weight: 400;
    color: var(--color-white);
    margin: 0;
  }

  :global(.hero-arrow) {
    color: var(--color-white);
    inline-size: 4em;
    block-size: 4em;
    transition: transform 0.3s;
  }

  section:hover :global(.hero-arrow) {
    transform: scale(1.3);
  }
</style>
