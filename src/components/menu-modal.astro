---
import { Icon } from "astro-icon/components"
import { Picture } from "astro:assets"
import type { ImageMetadata } from "astro"
import { menu } from "@data/menu"
import { libros } from "@data/libros"

const portadas = import.meta.glob('/src/assets/images/portadas/*.png', { eager: true })

const libroPorSlug = new Map(libros.map((l) => [l.id, l]))

function getPortadaMini(ruta?: string) {
  if (!ruta) return
  const slug = ruta.split('/').at(-1)
  const libro = libroPorSlug.get(slug!)
  if (!libro?.portadaMini) return
  const key = `/src/assets/images/portadas/${libro.portadaMini}`
  return (portadas[key] as { default: ImageMetadata })?.default
}
---

<dialog id="menu-modal">
  <header>
    <button type="button" class="modal-close" aria-label="Cerrar menú">
      <Icon name="close" />
    </button>
  </header>
  <nav>
    <a href="/" class="modal-logo">
      <Icon name="logo" />
    </a>
    <ul>
      {menu.map((item) => (
        <li>
          {item.hijos ? (
            <>
              <button type="button" aria-expanded="false">{item.texto}</button>
              <ul>
                {item.hijos.map((hijo) => (
                  hijo.hijos ? (
                    <li>
                      <h4>{hijo.texto}</h4>
                      <div class="sub-links">
                        {hijo.hijos.map((sub) => (
                          <a href={sub.ruta!}>{getPortadaMini(sub.ruta) && <Picture src={getPortadaMini(sub.ruta)!} formats={['avif', 'webp']} alt="" class="portada-mini" width={30} height={45} />}<span>{sub.texto}</span></a>
                        ))}
                      </div>
                    </li>
                  ) : (
                    <li><a href={hijo.ruta!}>{getPortadaMini(hijo.ruta) && <Picture src={getPortadaMini(hijo.ruta)!} formats={['avif', 'webp']} alt="" class="portada-mini" width={30} height={45} />}<span>{hijo.texto}</span></a></li>
                  )
                ))}
              </ul>
            </>
          ) : (
            <a href={item.ruta!}>{item.texto}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</dialog>

<style>
  #menu-modal {
    border: none;
    padding: 0;
    background: var(--color-black);
    inline-size: 100dvw;
    block-size: 100dvh;
    max-inline-size: 100dvw;
    max-block-size: 100dvh;
    overflow-y: auto;
  }

  #menu-modal::backdrop {
    background: var(--color-black);
  }

  #menu-modal > header {
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    padding: 1.2em;
    background: var(--color-black);
  }

  .modal-close {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.5em;
    block-size: 2.5em;
    border-radius: 50%;
    background-color: var(--color-black-soft);
    border: 1px solid var(--color-border-soft);
    color: var(--color-white-soft);
    font-family: inherit;
    cursor: pointer;
  }

  .modal-close :global(svg) {
    inline-size: 1.5em;
    block-size: 1.5em;
    fill: currentColor;
  }

  #menu-modal nav {
    display: flex;
    flex-direction: column;
  }

  .modal-logo {
    display: flex;
    justify-content: center;
    padding-block-end: 2em;
    color: var(--color-white);
  }

  .modal-logo :global(svg) {
    inline-size: 5em;
    block-size: 5em;
  }

  #menu-modal nav > ul {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    margin: 0;
  }

  #menu-modal nav > ul > li {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  #menu-modal nav > ul > li > a {
    display: flex;
    align-items: center;
    font-size: 1.2em;
    padding-block: 0.75em;
    padding-inline: 0;
    inline-size: 100%;
    border-block-end: 1px solid var(--color-border);
    color: var(--color-white-soft);
    text-decoration: none;
    font-weight: 600;
  }

  #menu-modal nav > ul > li > button {
    display: flex;
    align-items: center;
    font-size: 1.2em;
    padding-block: 0.75em;
    padding-inline: 0;
    inline-size: 100%;
    border-block-end: 1px solid var(--color-border);
    color: var(--color-white-soft);
    font-weight: 600;
    text-align: start;
    background: none;
    border-inline: none;
    border-block-start: none;
    font-family: inherit;
    cursor: pointer;
  }

  #menu-modal nav > ul > li:has(> ul) > button::after {
    content: '';
    display: inline-block;
    inline-size: 0.6em;
    block-size: 0.6em;
    margin-inline-start: auto;
    border-inline-end: 2px solid var(--color-white-soft);
    border-block-end: 2px solid var(--color-white-soft);
    transform: rotate(-45deg);
    transition: transform 0.2s, border-color 0.2s;
  }

  #menu-modal nav > ul > li.expanded:has(> ul) > button {
    color: var(--color-green-500);
  }

  #menu-modal nav > ul > li.expanded:has(> ul) > button::after {
    transform: rotate(45deg);
    border-color: var(--color-green-500);
  }

  #menu-modal li ul {
    display: none;
    position: static;
    border: none;
    padding: 0;
    padding-inline-start: 1em;
    background: none;
    border-radius: 0;
    min-inline-size: auto;
    margin: 0;
    list-style: none;
  }

  #menu-modal li.expanded > ul {
    display: flex;
    flex-direction: column;
  }

  #menu-modal li ul li a {
    display: flex;
    align-items: center;
    gap: 0.75em;
    padding-block: 0.5em;
    font-size: 1em;
    color: var(--color-white-soft);
    text-decoration: none;
    font-weight: 400;
  }

  #menu-modal li > h4 {
    padding-block: 0.5em;
    font-size: 0.75em;
    letter-spacing: 0.05em;
    opacity: 0.6;
    margin-block-end: 0.25em;
  }

  #menu-modal .sub-links {
    display: flex;
    flex-direction: column;
  }

  #menu-modal .sub-links a {
    display: flex;
    align-items: center;
    gap: 0.75em;
    padding-block: 0.5em;
    font-size: 1em;
    color: var(--color-white-soft);
    text-decoration: none;
    font-weight: 400;
  }

  #menu-modal .portada-mini {
    inline-size: 1.5em;
    block-size: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 0.2em;
  }

  #menu-modal li ul li a picture,
  #menu-modal .sub-links a picture {
    flex: none;
    inline-size: 1.5em;
  }

  #menu-modal[open] {
    animation: fade-in 0.3s ease;
  }

  #menu-modal[open]::backdrop {
    animation: fade-in 0.3s ease;
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (width > 1366px) {
    #menu-modal {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const modal = document.querySelector("#menu-modal")
    const closeBtn = document.querySelector(".modal-close")

    if (modal && closeBtn) {
      closeBtn.addEventListener("click", () => modal.close())

      modal.addEventListener("close", () => {
        document.documentElement.style.overflow = ""
        document.body.style.overflow = ""
      })

      modal.addEventListener("click", (e) => {
        const btn = e.target.closest("li > button")
        if (btn && btn.parentElement.querySelector(":scope > ul")) {
          const parent = btn.parentElement
          const siblings = [...parent.parentElement.children]
          siblings.forEach((s) => s !== parent && s.classList.remove("expanded"))
          const isExpanded = parent.classList.toggle("expanded")
          btn.setAttribute("aria-expanded", isExpanded)
        }
      })

      modal.addEventListener("click", (e) => {
        const link = e.target.closest("a[href]")
        if (link) modal.close()
      })
    }
  })
</script>
