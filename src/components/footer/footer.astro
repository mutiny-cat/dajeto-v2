---
import { Icon } from "astro-icon/components"
import { redesSociales } from "@data/redes"
import { enlacesLegales } from "@data/legal"

const anoActual = new Date().getFullYear()
---

<footer>
  <div class="social">
    {redesSociales.map((red) => (
      <a href={red.url} target="_blank" rel="noopener noreferrer" aria-label={red.nombre}>
        <Icon name={red.icono} />
      </a>
    ))}
  </div>

  <nav class="legal" aria-label="Enlaces legales y accesibilidad">
    {enlacesLegales.map((enlace) => (
      <a href={enlace.ruta}>{enlace.texto}</a>
    ))}
  </nav>

  <div class="copy">
    <Icon name="cc" aria-hidden="true" />
    <span>Daniel Jerez Torns (2005 - {anoActual})</span>
  </div>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3em /* 48px */;
    padding-block: 2em /* 32px */;
    padding-inline: 1em /* 16px */;

    @media (width < 768px) {
      padding-block-start: 4em /* 64px */;
    }

    @media (width >= 768px) {
      padding-block-start: 6em /* 96px */;
    }
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2.5em /* 40px */;
    margin-block-end: 2em /* 32px */;

    a {
      color: var(--color-white-soft);
      transition: color 0.3s ease;
      display: flex;
    }

    :global(svg) {
      inline-size: 2em /* 32px */;
      block-size: 2em /* 32px */;
      fill: currentColor;
    }

    @media (width <= 480px) {
      gap: 1.5em /* 24px */;
    }

    @media (width >= 768px) {
      a {
        transition: color 0.3s ease, transform 0.3s ease;

        &:hover {
          color: var(--color-green-500);
          transform: scale(1.2);
        }
      }

      :global(svg) {
        transition: filter 0.3s ease;
      }

      a:hover :global(svg) {
        filter: drop-shadow(0 0 0.5em /* 8px */ var(--color-green-500));
      }
    }
  }

  .legal {
    display: flex;
    gap: 2em /* 32px */;
    flex-wrap: wrap;
    justify-content: center;

    a {
      color: var(--color-white-soft);
      font-size: 0.875em /* 14px */;
      transition: color 0.3s ease;

      &:hover {
        color: var(--color-green-500);
      }
    }
  }

  .copy {
    display: flex;
    align-items: center;
    gap: 0.5em /* 8px */;
    padding-block-start: 1.5em /* 24px */;
    border-block-start: 1px solid var(--color-border);
    color: var(--color-white-soft);
    font-size: 0.875em /* 14px */;

    :global(svg) {
      inline-size: 1em /* 16px */;
      block-size: 1em /* 16px */;
      fill: currentColor;
    }
  }
</style>
