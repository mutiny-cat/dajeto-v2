---
import { Icon } from "astro-icon/components"
import { redesSociales } from "@data/redes"
import { enlacesLegales } from "@data/legal"

const anoActual = new Date().getFullYear()
---

<footer>
  <div class="social">
    {redesSociales.map((red) => (
      <a href={red.url} target="_blank" rel="noopener noreferrer" aria-label={red.nombre}>
        <Icon name={red.icono} />
      </a>
    ))}
  </div>

  <nav class="legal" aria-label="Enlaces legales y accesibilidad">
    {enlacesLegales.map((enlace) => (
      <a href={enlace.ruta}>{enlace.texto}</a>
    ))}
  </nav>

  <div class="copy">
    <Icon name="cc" aria-hidden="true" />
    <span>Daniel Jerez (2005 - {anoActual})</span>
  </div>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3em;
    padding-block: 2em;
    padding-inline: 1em;

    @media (width < 768px) {
      padding-block-start: 4em;
    }

    @media (width >= 768px) {
      padding-block-start: 6em;
    }
  }

  .social {
    display: flex;
    gap: 2.5em;
    margin-block-end: 2em;

    a {
      color: var(--color-white-soft);
      transition: color 0.3s ease;
      display: flex;

      &:hover {
        color: var(--color-green-500);
      }
    }

    :global(svg) {
      inline-size: 2em;
      block-size: 2em;
      fill: currentColor;
    }
  }

  .legal {
    display: flex;
    gap: 2em;
    flex-wrap: wrap;
    justify-content: center;

    a {
      color: var(--color-white-soft);
      font-size: 0.875em;
      transition: color 0.3s ease;

      &:hover {
        color: var(--color-green-500);
      }
    }
  }

  .copy {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding-block-start: 1.5em;
    border-block-start: 1px solid var(--color-border);
    color: var(--color-white-soft);
    font-size: 0.875em;

    :global(svg) {
      inline-size: 1em;
      block-size: 1em;
      fill: currentColor;
    }
  }
</style>
