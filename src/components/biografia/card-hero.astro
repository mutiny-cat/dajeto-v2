---
import type { ImageMetadata } from "astro"

export interface Props {
  titulo: string
  fondo?: ImageMetadata
}

const { titulo, fondo } = Astro.props
---

<section class="hero">
  {fondo && <img src={fondo.src} alt="" class="bg" fetchpriority="high" />}
  <article class="content">
    <div class="overlay">
      <h1 class="titulo">{titulo}</h1>
    </div>
  </article>
</section>

<style>
  .hero {
    grid-column: 1 / -1;
    position: relative;
    aspect-ratio: 21 / 9;
    border: 1px solid var(--color-border);
    border-radius: 0.75em /* 12px */;
    isolation: isolate;
  }

  .bg {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    border-radius: inherit;
  }

  .content {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    block-size: 100%;
    border-radius: inherit;
  }

  .overlay {
    padding: 3em /* 48px */ 4em /* 64px */;
    flex: 1;
  }

  .titulo {
    font-size: var(--text-h1);
    margin: 0;
  }

  @media (width <= 768px) {
    .overlay {
      padding: 1.5em /* 24px */;
    }

    .titulo {
      font-size: var(--text-h3);
    }
  }
</style>
