---
export interface Props {
  biografia: { id: string; texto: string }[]
}

const { biografia } = Astro.props
---

<section class="card">
  <h2>Biografía</h2>
  {biografia.map((p) => (
    <p>{p.texto}</p>
  ))}
</section>

<style>
  .card {
    grid-column: 1 / -1;
    background: var(--color-black-soft);
    border: 1px solid var(--color-border);
    border-radius: 0.75em /* 12px */;
    padding: 2em /* 32px */;
  }

  h2 {
    font-size: var(--text-h2);
    margin-block-end: 0.5em /* 8px */;
  }

  p + p {
    margin-block-start: 1em /* 16px */;
  }

  @media (width <= 768px) {
    .card {
      padding: 1.5em /* 24px */;
    }
  }

  @media (width <= 480px) {
    .card {
      padding: 1em /* 16px */;
    }
  }
</style>
