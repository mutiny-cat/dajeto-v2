---
export interface Props {
  biografia: { id: string; texto: string }[]
}

const { biografia } = Astro.props
---

<section class="card">
  <h2>Biografía</h2>
  {biografia.map((p) => (
    <p>{p.texto}</p>
  ))}
</section>

<style>
  .card {
    grid-column: 1 / -1;
    background: var(--color-black-soft);
    border: 1px solid var(--color-border);
    border-radius: 0.75em;
    padding: 1.5em;
  }

  h2 {
    font-size: var(--text-h2);
    margin-block-end: 0.5em;
  }

  p + p {
    margin-block-start: 1em;
  }
</style>
