---
import type { ImageMetadata } from "astro:assets"
import type { Biografia } from "@data/biografia"
import CardHero from "./card-hero.astro"
import CardSinopsis from "./card-sinopsis.astro"
import CardCita from "./card-cita.astro"
import CardBiografia from "./card-biografia.astro"

export interface Props {
  biografia: Biografia
  fondo?: ImageMetadata
  foto?: ImageMetadata
}

const { biografia: bio, fondo, foto } = Astro.props
---

<div class="grid">
  <CardHero titulo="Daniel Jerez" {fondo} />
  <CardCita cita={bio.cita} />
  <CardSinopsis sinopsis={bio.sinopsis} {foto} />
  <CardBiografia biografia={bio.biografia} />
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3em /* 48px */;
  }

  @media (width <= 768px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
