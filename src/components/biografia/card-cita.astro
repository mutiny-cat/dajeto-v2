---
export interface Props {
  cita: string
}

const { cita } = Astro.props
---

<section class="card">
  <blockquote>{cita}</blockquote>
</section>

<style>
  .card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2em 3em;
    background: var(--color-green-700);
    border: 1px solid var(--color-primary-600);
    border-radius: 0.75em;
  }

  .card::after {
    content: "\201D";
    position: absolute;
    z-index: 0;
    inset-block-start: -0.1em;
    inset-inline-start: 0em;
    font-size: 30em;
    line-height: 1;
    color: var(--color-white);
    opacity: 0.15;
  }

  blockquote {
    position: relative;
    z-index: 1;
    font-size: var(--text-base);
    font-weight: 600;
    font-style: italic;
    color: var(--color-white);
    line-height: 1.8;
    margin: 0;
    text-align: center;
  }
</style>
