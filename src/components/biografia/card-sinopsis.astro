---
import { Picture } from "astro:assets"
import type { ImageMetadata } from "astro:assets"

export interface Props {
  sinopsis: string
  foto?: ImageMetadata
}

const { sinopsis, foto } = Astro.props
---

<section class="card">
  {foto && <Picture src={foto} formats={['avif', 'webp']} alt="Daniel Jerez" class="photo" />}
  <div class="info">
    <h2>Sobre el autor</h2>
    <p>{sinopsis}</p>
  </div>
</section>

<style>
  .card {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2em /* 32px */;
    align-items: start;
    background: var(--color-primary-600);
    border: 1px solid var(--color-green-700);
    border-radius: 0.75em /* 12px */;
    padding: 2em /* 32px */;
  }

  .photo {
    inline-size: 100%;
    block-size: auto;
    border-radius: 0.5em /* 8px */;
  }

  .info h2 {
    font-size: var(--text-h2);
    margin-block-end: 0.5em /* 8px */;
  }

  .info p {
    font-size: var(--text-base);
    line-height: 1.8;
    margin: 0;
  }

  @media (width <= 768px) {
    .card {
      grid-template-columns: 1fr;
      padding: 1.5em /* 24px */;
    }
  }

  @media (width <= 480px) {
    .card {
      padding: 1em /* 16px */;
    }
  }
</style>
