---
import { Icon } from "astro-icon/components"
import { menu } from "@data/menu"
---

<header>
  <a href="/" class="logo">
    <Icon name="logo" />
  </a>
  <nav>
    <ul>
      {menu.map((item) => (
        <li>
          {item.hijos ? (
            <>
              <span>{item.texto}</span>
              <ul>
                {item.hijos.map((hijo) => (
                  hijo.hijos ? (
                    <li>
                      <h4>{hijo.texto}</h4>
                      <div class="sub-links">
                        {hijo.hijos.map((sub) => (
                          <a href={sub.ruta!}>{sub.texto}</a>
                        ))}
                      </div>
                    </li>
                  ) : (
                    <li><a href={hijo.ruta!}>{hijo.texto}</a></li>
                  )
                ))}
              </ul>
            </>
          ) : (
            <a href={item.ruta!}>{item.texto}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>
  <button class="menu-toggle" aria-label="Abrir menú">
    <Icon name="menu" />
  </button>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
		padding: 2.4em;
		position: fixed;
    inset-block-start: 0;
		inset-inline: 0;
		background: linear-gradient(to bottom, var(--color-bg), transparent);
    z-index: 10;
  }

  .logo {
    display: flex;
    align-items: center;
    color: var(--color-text);
    font-weight: 700;
    font-size: 1em;
    text-decoration: none;
  }

  .logo :global(svg) {
    inline-size: 2.5em;
    block-size: 2.5em;
  }

  .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .menu-toggle :global(svg) {
    inline-size: 1.5em;
    block-size: 1.5em;
    fill: currentColor;
  }

  nav {
    border: 1px solid var(--color-border);
    border-radius: 2em;
    padding: 0.5em 1.25em;

    ul {
      display: flex;
      gap: 1.5em;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    li {
      position: relative;
    }

    li ul {
      display: none;
      position: absolute;
      inset-block-start: 100%;
      inset-inline-start: 0;
      flex-direction: column;
      gap: 0;
      background-color: var(--color-bg);
      border: 1px solid var(--color-border);
      padding: 0.5em 0;
      min-inline-size: max-content;
      z-index: 20;
    }

    li:hover > ul,
    li ul:hover {
      display: flex;
    }

    li ul li {
      padding: 0.25em 1em;
      white-space: nowrap;
    }

    li > .sub-links {
      display: flex;
      flex-direction: column;
    }

    li ul h4 {
      font-size: 0.75em;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-soft);
      opacity: 0.6;
      margin-block-end: 0.25em;
    }

    a, span {
      color: var(--color-text-soft);
      font-size: 1em;
      font-weight: 600;
      text-decoration: none;
      transition: color 0.2s;
    }

    span {
      cursor: default;
    }

    a {
      cursor: pointer;

      &:hover {
        color: var(--color-accent);
      }
    }
  }

  @media (width <= 768px) {
    .menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    nav {
      display: none;
      position: fixed;
      inset: 4em 0 0;
      background-color: var(--color-bg);
      border-block-start: 1px solid var(--color-border);
      overflow-y: auto;
      z-index: 10;

      &.is-open {
        display: block;
      }

      ul {
        flex-direction: column;
        gap: 0;
        padding: 1em;
      }

      li ul {
        position: static;
        display: flex;
        border: none;
        padding: 0;
        padding-inline-start: 1em;
      }
    }
  }
</style>

<script>
  document.querySelector(".menu-toggle")?.addEventListener("click", () => {
    document.querySelector("nav")?.classList.toggle("is-open")
  })
</script>
