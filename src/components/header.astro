---
import { Icon } from "astro-icon/components"
import { Picture } from "astro:assets"
import type { ImageMetadata } from "astro"
import { menu } from "@data/menu"
import { libros } from "@data/libros"
import MenuModal from "./menu-modal.astro"

const portadas = import.meta.glob('/src/assets/images/portadas/*.png', { eager: true })

const libroPorSlug = new Map(libros.map((l) => [l.id, l]))

function getPortadaMini(ruta?: string) {
  if (!ruta) return
  const slug = ruta.split('/').at(-1)
  const libro = libroPorSlug.get(slug!)
  if (!libro?.portadaMini) return
  const key = `/src/assets/images/portadas/${libro.portadaMini}`
  return (portadas[key] as { default: ImageMetadata })?.default
}
---

<header>
  <a href="/" class="logo">
    <Icon name="logo" />
  </a>
  <nav>
    <ul>
      {menu.map((item) => (
        <li>
          {item.hijos ? (
            <>
              <span>{item.texto}</span>
              <ul>
                {item.hijos.map((hijo) => (
                  hijo.hijos ? (
                    <li>
                      <h4>{hijo.texto}</h4>
                      <div class="sub-links">
                        {hijo.hijos.map((sub) => (
                          <a href={sub.ruta!}>{getPortadaMini(sub.ruta) && <Picture src={getPortadaMini(sub.ruta)!} formats={['avif', 'webp']} alt="" class="portada-mini" width={30} height={45} />}<span>{sub.texto}</span></a>
                        ))}
                      </div>
                    </li>
                  ) : (
                    <li><a href={hijo.ruta!}>{getPortadaMini(hijo.ruta) && <Picture src={getPortadaMini(hijo.ruta)!} formats={['avif', 'webp']} alt="" class="portada-mini" width={30} height={45} />}<span>{hijo.texto}</span></a></li>
                  )
                ))}
              </ul>
            </>
          ) : (
            <a href={item.ruta!}>{item.texto}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>
  <button class="menu-toggle" aria-label="Abrir menú">
    <Icon name="menu" />
  </button>
  <MenuModal />
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
		padding: 2.4em;
		position: fixed;
    inset-block-start: 0;
		inset-inline: 0;
		background: linear-gradient(to bottom, var(--color-black), transparent);
    z-index: var(--z-index-header, 10);
  }

  .logo {
    display: flex;
    align-items: center;
    color: var(--color-white);
    font-weight: 700;
    font-size: 1em;
    text-decoration: none;
    transition: transform 0.5s;

    &:hover {
      transform: scale(1.1);
    }
  }

  .logo :global(svg) {
    inline-size: 2.5em;
    block-size: 2.5em;
  }

  .menu-toggle {
    display: flex;
    opacity: 0;
    pointer-events: none;
    align-items: center;
    justify-content: center;
  }

  .menu-toggle :global(svg) {
    inline-size: 1.5em;
    block-size: 1.5em;
    fill: currentColor;
  }

  .portada-mini {
    inline-size: 1.5em;
    block-size: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 0.2em;
  }

  li ul li a picture,
  .sub-links a picture {
    flex: none;
    inline-size: 1.5em;
  }

  nav {
    border: 1px solid var(--color-border);
    border-radius: 2em;
    padding: 0.75em 1.5em;

    ul {
      display: flex;
      gap: 0;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    > ul > li {
      display: flex;
      align-items: center;
      position: relative;

      &::after {
        content: '';
        position: absolute;
        inset-block-start: 100%;
        inset-inline: 0;
        block-size: 1em;
      }
    }

    > ul > li + li::before {
      content: '·';
      font-size: 1.5em;
      line-height: 1;
      color: var(--color-white-soft);
      margin-inline: 0.5em;
    }

    li ul {
      display: flex;
      position: absolute;
      inset-block-start: calc(100% + 1em);
      inset-inline-start: 0;
      flex-direction: column;
      gap: 0;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.5s ease, visibility 0.5s ease;
      background: rgb(10 10 10 / 0.95);
      border: 1px solid var(--color-border);
      border-radius: 0.75em;
      padding: 0.5em 0;
      min-inline-size: max-content;
      z-index: var(--z-index-submenu, 20);
    }

    li:hover > ul,
    li ul:hover {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    li ul li {
      padding: 0.5em 1em;
      white-space: nowrap;

      a {
        display: flex;
        align-items: center;
        gap: 0.75em;
        font-weight: 400;
        font-size: 0.9em;
        padding: 0.25em 0.5em;
        border-radius: 0.4em;
        transition: 0.2s;

        &:hover {
          background-color: var(--color-gray-dark);
        }
      }
    }

    li > .sub-links {
      display: flex;
      flex-direction: column;

      a {
        display: flex;
        align-items: center;
        gap: 0.75em;
        padding: 0.25em 0.5em;
        margin-block: 0.25em;
        border-radius: 0.4em;
        font-weight: 400;
        font-size: 0.9em;
        transition: 0.2s;

        &:hover {
          background-color: var(--color-gray-dark);
        }
      }
    }

    li ul h4 {
      font-size: 0.75em;
      letter-spacing: 0.05em;
      color: var(--color-white-soft);
      opacity: 0.6;
      margin-block-end: 0.25em;
    }

    a, span {
      display: block;
      color: var(--color-white-soft);
      font-size: 1em;
      font-weight: 600;
      text-decoration: none;
      transition: color 0.2s;
    }

    span {
      cursor: default;
    }

    li:hover > span {
      color: var(--color-green-500);
    }

    a span {
      cursor: pointer;
    }

    a {
      cursor: pointer;

      &:hover {
        color: var(--color-green-500);

        > span {
          color: inherit;
        }
      }
    }
  }

  @media (width > 1366px) {
    nav > ul > li:nth-child(3) > ul {
      flex-direction: row;
      gap: 2em;
      padding: 1em;
    }
  }

  @media (width <= 1366px) {
    header {
      padding: 1.2em;
    }

    nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      inline-size: 2.5em;
      block-size: 2.5em;
      opacity: 1;
      pointer-events: auto;
      z-index: var(--z-index-modal, 101);
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const toggle = document.querySelector(".menu-toggle")
    const modal = document.querySelector("#menu-modal")

    if (toggle && modal) {
      toggle.addEventListener("click", () => {
        if (!modal.open) {
          modal.querySelectorAll(".expanded").forEach((el) => {
            el.classList.remove("expanded")
            el.querySelector("button")?.setAttribute("aria-expanded", "false")
          })
          document.documentElement.style.overflow = "hidden"
          document.body.style.overflow = "hidden"
          modal.showModal()
        }
      })
    }
  })
</script>
