---
import type { EventoTrayectoria } from "@data/cronologia"

export interface Props {
  trayectoria: EventoTrayectoria[]
}

const { trayectoria } = Astro.props
---

<div class="timeline">
  <div class="timeline-line"></div>
  {trayectoria.map((evento, i) => (
    <div class="timeline-item">
      <div class="timeline-dot"></div>
      <article class="timeline-card">
        <time class="timeline-ano">{evento.ano}</time>
        <h3 class="timeline-titulo">{evento.titulo}</h3>
        <p class="timeline-desc">{evento.descripcion}</p>
      </article>
    </div>
  ))}
</div>

<style>
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3em;
    padding-block: 2em;
  }

  .timeline-line {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 50%;
    inline-size: 2px;
    background: var(--color-green-500);
    translate: -50% 0;
  }

  .timeline-item {
    position: relative;
    display: flex;
    align-items: flex-start;
  }

  .timeline-dot {
    position: absolute;
    inset-inline-start: 50%;
    translate: -50% 0.3em;
    inline-size: 1em;
    block-size: 1em;
    border-radius: 50%;
    background: var(--color-green-500);
    box-shadow: 0 0 0.5em var(--color-green-500);
    z-index: 1;
  }

  .timeline-card {
    inline-size: calc(50% - 2em);
    margin-inline-start: auto;
    padding: 1.5em;
    border: 1px solid var(--color-border);
    border-radius: 1em;
    background: var(--color-black-soft);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .timeline-card:hover {
    border-color: var(--color-green-500);
    box-shadow: 0 0 1em color-mix(in srgb, var(--color-green-500) 20%, transparent);
  }

  .timeline-item:nth-child(odd) .timeline-card {
    margin-inline-start: 0;
    margin-inline-end: auto;
  }

  .timeline-ano {
    display: inline-block;
    font-size: 0.875em;
    font-weight: 700;
    color: var(--color-green-500);
    margin-block-end: 0.5em;
  }

  .timeline-titulo {
    font-size: var(--text-h4);
    font-weight: 700;
    color: var(--color-white);
    margin-block-end: 0.5em;
  }

  .timeline-desc {
    font-size: 0.875em;
    color: var(--color-white-soft);
    line-height: 1.6;
  }

  @media (width <= 768px) {
    .timeline {
      gap: 2em;
    }

    .timeline-line {
      inset-inline-start: 1em;
    }

    .timeline-dot {
      inset-inline-start: 1em;
    }

    .timeline-card {
      inline-size: 100%;
      margin-inline-start: 2.5em;
    }

    .timeline-item:nth-child(odd) .timeline-card {
      margin-inline-start: 2.5em;
      margin-inline-end: 0;
    }
  }
</style>
