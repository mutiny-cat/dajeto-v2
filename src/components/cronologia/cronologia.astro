---
import { Icon } from "astro-icon/components"
import type { EventoTrayectoria } from "@data/cronologia"

export interface Props {
  trayectoria: EventoTrayectoria[]
}

const { trayectoria } = Astro.props
---

<h2 class="timeline-heading">Cronología</h2>
<div class="card-container">
  <div class="timeline-orb">
    <Icon name="logo" />
  </div>
  <div class="timeline-line"></div>
  {trayectoria.map((evento) => (
      <section class="card-timeline">
        <div class="card-content">
          <div class="card-meta">
            <time class="card-ano">{evento.ano}</time>
          </div>
          <h3 class="card-titulo">{evento.titulo}</h3>
          <p class="card-desc">{evento.descripcion}</p>
        </div>
      </section>
  ))}
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const container = document.querySelector(".card-container")
    const orb = document.querySelector(".timeline-orb")
    const cards = document.querySelectorAll(".card-timeline")
    const BUFFER = 50

    function updateOrb() {
      if (!container || !orb) return
      const max = Math.max(0, (container.offsetHeight ?? 0) - BUFFER)
      const progress = Math.min(max, window.scrollY)
      orb.style.setProperty("--top", `${progress}px`)
    }

    function updateProgreso() {
      if (!container || cards.length === 0) return
      const scrollY = window.scrollY
      const containerTop = container.offsetTop
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight
      const estaAlFondo = scrollY >= maxScroll - 20

      let highestVisible = -1

      if (scrollY > 10) {
        cards[0].style.setProperty("--dot-opacity", "1")
        cards[0].classList.add("is-visible")
        highestVisible = 0
        orb?.style.setProperty("--orb-scale", "1")
        orb?.style.setProperty("--orb-color", "var(--color-green-500)")
        orb?.style.setProperty("--orb-svg-color", "var(--color-green-500)")
        container?.style.setProperty("--line-color", "var(--color-green-500)")
      } else {
        cards[0].style.setProperty("--dot-opacity", "0")
        cards[0].classList.remove("is-visible")
        orb?.style.setProperty("--orb-scale", "1.5")
        orb?.style.setProperty("--orb-color", "var(--color-green-600)")
        orb?.style.removeProperty("--orb-svg-color")
        container?.style.setProperty("--line-color", "var(--color-green-600)")
      }

      for (let i = 1; i < cards.length; i++) {
        const prev = cards[i - 1]
        const puntoActivar = containerTop + prev.offsetTop + prev.offsetHeight * 0.1
        if (scrollY >= puntoActivar || estaAlFondo) {
          cards[i].style.setProperty("--dot-opacity", "1")
          cards[i].classList.add("is-visible")
          highestVisible = i
        } else {
          cards[i].style.setProperty("--dot-opacity", "0")
          cards[i].classList.remove("is-visible")
        }
      }

      cards.forEach((c) => c.classList.remove("is-current"))
      if (highestVisible >= 0) {
        cards[highestVisible].classList.add("is-current")
      }
    }

    function ajustarEspaciado() {
      if (!container || cards.length < 2) return
      const fontSize = parseFloat(getComputedStyle(document.documentElement).fontSize)
      const orbOffset = window.innerWidth >= 768 ? 4 : 3
      const ultimaCard = cards[cards.length - 1]
      const ultimoDotY = container.offsetTop + ultimaCard.offsetTop + ultimaCard.offsetHeight / 2
      const scrollTarget = ultimoDotY - container.offsetTop + orbOffset * fontSize
      const deficit = scrollTarget - (document.documentElement.scrollHeight - window.innerHeight)
      const basePadding = 12 * fontSize
      container.style.paddingBlockEnd = `${basePadding + Math.max(0, deficit) + 40}px`
    }

    function onScroll() {
      requestAnimationFrame(() => {
        updateOrb()
        updateProgreso()
      })
    }

    window.addEventListener("scroll", onScroll, { passive: true })
    window.addEventListener("resize", () => {
      updateProgreso()
      ajustarEspaciado()
    })
    updateOrb()
    updateProgreso()
    ajustarEspaciado()
  })
</script>

<style>
  .timeline-heading {
    text-align: center;
    font-size: var(--text-h2);
    color: var(--color-white);
    margin-block-end: 1.5em /* 24px */;
  }

  .card-container {
    position: relative;
    max-inline-size: 900px;
    margin-inline: auto;
    padding-block-end: 12em /* 192px */;
  }

  .timeline-orb {
    --orb-color: var(--color-green-600);
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: calc(var(--top, 0px) - 4.25em /* 68px */);
    z-index: 2;
    inline-size: 2.5em /* 40px */;
    block-size: 2.5em /* 40px */;
    border-radius: 50%;
    border: 2px solid var(--orb-color);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-black);
    box-shadow: 0 0 1.5em /* 24px */ color-mix(in srgb, var(--orb-color) 30%, transparent);
    transition: transform 0.5s ease, border-color 0.5s ease, box-shadow 0.5s ease;
    transform: scale(var(--orb-scale, 1.5));
  }

  .timeline-orb :global(svg) {
    inline-size: 1.8em /* 29px */;
    block-size: 1.8em /* 29px */;
    fill: var(--orb-svg-color, var(--color-black));
    transition: fill 0.5s ease;
  }

  .timeline-line {
    position: absolute;
    inset-block-start: -3em /* -48px */;
    inset-block-end: 0;
    inset-inline-start: 2em /* 32px */;
    inline-size: 2px;
    background: linear-gradient(
      180deg,
      var(--line-color) 0%,
      var(--line-color) 0%,
      transparent 100%
    );
    translate: -50% 0;
  }

  .card-timeline {
    position: relative;
    padding-inline-start: 4em /* 64px */;
    padding-block: 1.5em /* 24px */;
    opacity: 0.3;
    transition: opacity 0.5s ease;
  }

  .card-timeline::before {
    content: "";
    position: absolute;
    inset-inline-start: calc(2em /* 32px */ - 0.4em /* 6px */);
    inset-block-start: 50%;
    translate: 0 -50%;
    inline-size: 0.8em /* 13px */;
    block-size: 0.8em /* 13px */;
    border-radius: 50%;
    background: var(--color-green-500);
    box-shadow: 0 0 0.5em /* 8px */ var(--color-green-500);
    z-index: 1;
    opacity: var(--dot-opacity, 0);
    transition: opacity 0.3s ease;
  }

  .card-timeline.is-visible {
    opacity: 1;
  }

  .card-content {
    border: 1px solid var(--color-border);
    border-radius: 1em /* 16px */;
    background: var(--color-black-soft);
    padding: 1.5em /* 24px */;
    transition: border-color 0.5s ease;
  }

  .card-timeline.is-current .card-content {
    border-color: var(--color-green-500);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 1em /* 16px */;
    margin-block-end: 0.75em /* 12px */;
    flex-wrap: wrap;
  }

  .card-ano {
    font-size: 0.75em /* 12px */;
    font-weight: 700;
    color: var(--color-white);
    letter-spacing: 0.15em /* 2px */;
    border: 1px solid var(--color-green-500);
    border-radius: 2em /* 32px */;
    padding: 0.2em /* 3px */ 0.8em /* 13px */;
  }

  .card-titulo {
    font-size: var(--text-h4);
    font-weight: 700;
    color: var(--color-white);
    margin-block-end: 0.5em /* 8px */;
  }

  .card-desc {
    font-size: 0.875em /* 14px */;
    color: var(--color-white-soft);
    line-height: 1.6;
  }

  @media (width >= 768px) {
    .timeline-orb {
      inset-inline-start: 50%;
      translate: -50% 0;
      inline-size: 3em /* 48px */;
      block-size: 3em /* 48px */;
      inset-block-start: calc(var(--top, 0px) - 5.5em /* 88px */);
    }

    .timeline-orb :global(svg) {
      inline-size: 2em /* 32px */;
      block-size: 2em /* 32px */;
    }

    .timeline-line {
      inset-inline-start: 50%;
      inset-block-start: -4em /* -64px */;
    }

    .card-timeline {
      padding-inline-start: 0;
      inline-size: calc(50% - 3em /* 48px */);
    }

    .card-timeline:nth-child(odd) {
      margin-inline-start: auto;
    }

    .card-timeline::before {
      display: none;
    }

    .card-timeline:nth-child(odd)::after {
      content: "";
      position: absolute;
      inset-inline-start: -3.4em /* -54px */;
      inset-block-start: 50%;
      translate: 0 -50%;
      inline-size: 0.8em /* 13px */;
      block-size: 0.8em /* 13px */;
      border-radius: 50%;
      background: var(--color-green-500);
      box-shadow: 0 0 0.5em /* 8px */ var(--color-green-500);
      z-index: 1;
    }

    .card-timeline:nth-child(even)::after {
      content: "";
      position: absolute;
      inset-inline-end: -3.4em /* -54px */;
      inset-block-start: 50%;
      translate: 0 -50%;
      inline-size: 0.8em /* 13px */;
      block-size: 0.8em /* 13px */;
      border-radius: 50%;
      background: var(--color-green-500);
      box-shadow: 0 0 0.5em /* 8px */ var(--color-green-500);
      z-index: 1;
    }

    .card-timeline::before,
    .card-timeline::after {
      opacity: var(--dot-opacity, 0);
      transition: opacity 0.3s ease;
    }
  }
</style>
