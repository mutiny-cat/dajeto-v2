---
import PageLayout from "@layouts/page-layout.astro"
import { Picture } from "astro:assets"

const portada = await import("/src/assets/images/portadas/portada-el-canto-del-gallo.png")
const fondo = "/assets/fondos/bg-el-canto-del-gallo.jpg"
const libroImg = await import("/src/assets/images/libro/libro-el-canto-del-gallo.png")

const libro = {
  titulo: "El canto del gallo",
  ano: 2026,
  paginas: 416,
  editorial: "Autoedición",
  isbn: "978-84-126597-3-7",
  idioma: "Castellano",
  sinopsis:
    "La agente Lorena Escudero encuentra el cuerpo de Nadia Lozano en el estanque de La Ricarda. Una joven periodista. Una mente inquieta. Alguien que hacía demasiadas preguntas. Poco después, una cadena de muertes sacude familias importantes. Las víctimas no parecen tener relación entre sí… hasta que un detalle comienza a repetirse. Una venganza que no distingue entre inocentes y culpables.",
  enlaces: [
    { tienda: "Amazon", url: "https://www.amazon.es/canto-gallo-Daniel-Jerez-Torns/dp/B0GSFNMQ7H", formato: "tapa-blanda" },
    { tienda: "Amazon", url: "https://www.amazon.es/canto-gallo-Daniel-Jerez-Torns-ebook/dp/B0GSCGHFJG", formato: "ebook" },
  ],
}
---

<PageLayout title={libro.titulo}>
  <div class="page-grid">
    <!-- 1. Hero card -->
    <section class="card hero-card" style="background-image: url('{fondo}')">
      <div class="hero-overlay">
        <h1>{libro.titulo}</h1>
        <p class="hero-sub">Daniel Jerez Torns · {libro.ano}</p>
      </div>
    </section>

    <!-- 2. Quote card -->
    <section class="card quote-card">
      <blockquote>
        «Nadia Lozano hizo la pregunta equivocada. La última de su vida.»
      </blockquote>
    </section>

    <!-- 3. Cover + description card -->
    <section class="card cover-card">
      <Picture src={portada.default} formats={['avif', 'webp']} alt={libro.titulo} class="cover-img" />
      <div class="cover-info">
        <h2>Sinopsis</h2>
        <p>{libro.sinopsis}</p>
      </div>
    </section>

    <!-- 4. Content card -->
    <section class="card content-card">
      <h2>La obra</h2>
      <p>
        {libro.titulo} es la obra más ambiciosa de Daniel Jerez Torns. Con 416 páginas, el autor
        teje una trama policiaca que atrapa desde la primera página. La protagonista, la agente
        Lorena Escudero, se enfrenta a un caso que pone a prueba no solo su instinto, sino también
        su propia integridad.
      </p>
      <p>
        Una historia que explora los límites de la justicia, el poder de la prensa y las
        consecuencias de buscar la verdad en un mundo donde las apariencias engañan.
      </p>
    </section>

    <!-- 5. Info card -->
    <section class="card info-card">
      <h2>Detalles</h2>
      <dl>
        <dt>Idioma</dt>
        <dd>{libro.idioma}</dd>
        <dt>Páginas</dt>
        <dd>{libro.paginas}</dd>
        <dt>Año</dt>
        <dd>{libro.ano}</dd>
        <dt>Editorial</dt>
        <dd>{libro.editorial}</dd>
        <dt>ISBN</dt>
        <dd>{libro.isbn}</dd>
      </dl>
    </section>

    <!-- 6. Purchase card -->
    <section class="card buy-card">
      <h2>Comprar</h2>
      <div class="buy-list">
        {libro.enlaces.map((e) => (
          <a href={e.url} target="_blank" rel="noopener noreferrer" class="buy-item">
            <span class="buy-store">{e.tienda}</span>
            <span class="buy-format">{e.formato}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .page-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1em;
    padding-block-end: 4em;
  }

  .card {
    background: var(--color-black-soft);
    border: 1px solid var(--color-border);
    border-radius: 0.75em;
    padding: 1.5em;
    overflow: hidden;
  }

  /* Hero: full width */
  .hero-card {
    grid-column: 1 / -1;
    padding: 0;
    aspect-ratio: 21 / 9;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
    border: none;
  }

  .hero-overlay {
    inline-size: 100%;
    padding: 2em;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.85));
  }

  .hero-overlay h1 {
    font-size: var(--text-h1);
    margin: 0;
  }

  .hero-sub {
    color: var(--color-white-soft);
    font-size: 1em;
    margin-block-start: 0.5em;
  }

  /* Quote: spans 2 columns */
  .quote-card {
    grid-column: 1 / -1;
    text-align: center;
    padding: 2em 3em;
  }

  .quote-card blockquote {
    font-size: var(--text-h3);
    font-style: italic;
    color: var(--color-white);
    line-height: 1.4;
  }

  /* Cover + description */
  .cover-card {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2em;
    align-items: start;
  }

  .cover-img {
    inline-size: 100%;
    block-size: auto;
    border-radius: 0.5em;
  }

  .cover-info h2 {
    font-size: var(--text-h2);
    margin-block-end: 0.5em;
  }

  /* Content: full width */
  .content-card {
    grid-column: 1 / -1;
  }

  .content-card h2 {
    font-size: var(--text-h2);
    margin-block-end: 0.5em;
  }

  .content-card p + p {
    margin-block-start: 1em;
  }

  /* Info: half width */
  .info-card {
    grid-column: span 1;
  }

  .info-card h2 {
    font-size: var(--text-h3);
    margin-block-end: 0.75em;
  }

  .info-card dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5em 1em;
  }

  .info-card dt {
    color: var(--color-white-soft);
    font-weight: 600;
  }

  .info-card dd {
    margin: 0;
  }

  /* Buy: half width */
  .buy-card {
    grid-column: span 1;
  }

  .buy-card h2 {
    font-size: var(--text-h3);
    margin-block-end: 0.75em;
  }

  .buy-list {
    display: flex;
    flex-direction: column;
    gap: 0.75em;
  }

  .buy-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75em 1em;
    background: var(--color-gray);
    border-radius: 0.5em;
    color: var(--color-white);
    text-decoration: none;
    transition: background 0.2s;
  }

  .buy-item:hover {
    background: var(--color-gray-dark);
  }

  .buy-store {
    font-weight: 600;
  }

  .buy-format {
    font-size: 0.85em;
    color: var(--color-white-soft);
    text-transform: capitalize;
  }

  @media (width <= 768px) {
    .cover-card {
      grid-template-columns: 1fr;
    }

    .quote-card {
      padding: 1.5em;
    }
  }
</style>
