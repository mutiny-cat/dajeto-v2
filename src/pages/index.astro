---
import PageLayout from "@layouts/page-layout.astro"
import CardHero from "@components/index/card-hero.astro"
import GridNovedades from "@components/index/novedades/grid-novedades.astro"
import GridCategoria from "@components/index/categoria/grid-categoria.astro"
import type { ImageMetadata } from "astro"
import { libros } from "@data/libros"
import type { Libro } from "@data/libros"

const portadas = import.meta.glob('/src/assets/images/portadas/*.png', { eager: true })
const fondos = import.meta.glob('/src/assets/images/fondos/*.jpg', { eager: true })
const fondosBlur = import.meta.glob('/src/assets/images/fondos/blurred/*.jpg', { eager: true })
const librosImg = import.meta.glob('/src/assets/images/libro/*.png', { eager: true })

function getPortada(libro: Libro): ImageMetadata | undefined {
  if (!libro.portadaMini) return
  const key = `/src/assets/images/portadas/${libro.portadaMini}`
  return (portadas[key] as { default: ImageMetadata })?.default
}

function getFondo(libro: Libro): ImageMetadata | undefined {
  const key = `/src/assets/images/fondos/bg-${libro.id}.jpg`
  return (fondos[key] as { default: ImageMetadata })?.default
}

function getFondoBlur(libro: Libro): ImageMetadata | undefined {
  const key = `/src/assets/images/fondos/blurred/bg-${libro.id}.jpg`
  return (fondosBlur[key] as { default: ImageMetadata })?.default
}

function getLibroImg(libro: Libro): ImageMetadata | undefined {
  const key = `/src/assets/images/libro/libro-${libro.id}.png`
  return (librosImg[key] as { default: ImageMetadata })?.default
}

const novedades = [...libros].sort((a, b) => new Date(b.fechaAgregado).getTime() - new Date(a.fechaAgregado).getTime()).slice(0, 4)

const ultimaNovela = [...libros].filter((l) => l.categoria === "novela").sort((a, b) => b.ano - a.ano)[0]

const novelas = libros.filter((l) => l.categoria === "novela")
const novelasCortas = libros.filter((l) => l.categoria === "novela-corta")
const cuentosAdol = libros.filter((l) => l.categoria === "cuento-adolescente")
const cuentosInf = libros.filter((l) => l.categoria === "cuento-infantil")
---

<PageLayout title="Daniel Jerez Torns — Escritor de novela negra, misterio y ciencia ficción">
  <section style="content-visibility: auto">
    {ultimaNovela && <CardHero libro={ultimaNovela} fondo={getFondo(ultimaNovela)} />}
  </section>

  <!-- Novedades -->
  <section style="content-visibility: auto">
    <GridNovedades libros={novedades.map(l => ({ libro: l, portada: getPortada(l) }))} />
  </section>

  <!-- Novela -->
  <section style="--categoria-grid-bg: var(--color-novela); --categoria-hover-glow: var(--color-novela-glow); content-visibility: auto">
    <GridCategoria titulo="Novela" libros={novelas.map(l => ({ libro: l, fondo: getFondoBlur(l), libroImg: getLibroImg(l) }))} />
  </section>

  <!-- Novela corta -->
  <section style="--categoria-grid-bg: var(--color-novela-corta); --categoria-hover-glow: var(--color-novela-corta-glow); content-visibility: auto">
    <GridCategoria titulo="Novela corta" libros={novelasCortas.map(l => ({ libro: l, fondo: getFondoBlur(l), libroImg: getLibroImg(l) }))} />
  </section>

  <!-- Cuentos adolescentes -->
  <section style="--categoria-grid-bg: var(--color-cuento-adolescente); --categoria-hover-glow: var(--color-cuento-adolescente-glow); content-visibility: auto">
    <GridCategoria titulo="Cuentos" libros={cuentosAdol.map(l => ({ libro: l, fondo: getFondoBlur(l), libroImg: getLibroImg(l) }))} />
  </section>

  <!-- Cuentos infantiles -->
  <section style="--categoria-grid-bg: var(--color-cuento-infantil); --categoria-hover-glow: var(--color-cuento-infantil-glow); content-visibility: auto">
    <GridCategoria titulo="Cuentos infantiles" libros={cuentosInf.map(l => ({ libro: l, fondo: getFondoBlur(l), libroImg: getLibroImg(l) }))} />
  </section>
</PageLayout>