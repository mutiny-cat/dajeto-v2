---
import BaseLayout from "../layouts/BaseLayout.astro"
import { books, timeline } from "../data/books"

const latestNovel = books.filter((b) => b.category === "novela").sort((a, b) => b.year - a.year)[0]
const featured = books.slice(0, 3)
---

<BaseLayout title="Inicio" description="Daniel Jerez Torns — Escritor de novela negra, misterio e intriga">
  <section class="hero">
    <div class="container hero__content">
      <div class="hero__text">
        <p class="hero__label">Escritor de novela negra y misterio</p>
        <h1>Daniel Jerez Torns</h1>
        <p class="hero__subtitle">
          «El pasado jamás se olvida, pero los intentos de taparlo o negarlo repercuten en el ahora,
          y es ahí donde las consecuencias se hacen visibles.»
        </p>
        <div class="hero__actions">
          <a href="/novelas" class="btn">Ver novelas</a>
          <a href="/biografia" class="btn btn--outline">Sobre el autor</a>
        </div>
      </div>
      <div class="hero__latest">
        <span class="hero__latest-label">Última novela</span>
        <h2 class="hero__latest-title">{latestNovel.title}</h2>
        <p class="hero__latest-year">{latestNovel.year}</p>
        <p class="hero__latest-desc">{latestNovel.sinopsis}</p>
        {latestNovel.amazon && (
          <a href={latestNovel.amazon} target="_blank" rel="noopener" class="btn">
            Comprar en Amazon
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section__title">Obras destacadas</h2>
      <div class="grid">
        {featured.map((book) => (
          <article class="book-card">
            <div class="book-card__header">
              <h3 class="book-card__title">{book.title}</h3>
              {book.titleSub && <p class="book-card__sub">{book.titleSub}</p>}
              <span class="book-card__year">{book.year}</span>
            </div>
            <p class="book-card__desc">{book.sinopsis}</p>
            <div class="book-card__footer">
              <span class="book-card__cat">{book.category === "novela" ? "Novela" : book.category === "novela-corta" ? "Novela corta" : "Cuento"}</span>
              {book.amazon && (
                <a href={book.amazon} target="_blank" rel="noopener" class="btn btn--sm">Amazon</a>
              )}
            </div>
          </article>
        ))}
      </div>
      <div style="text-align: center; margin-top: 3rem;">
        <a href="/novelas" class="btn">Ver todas las obras</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2 class="section__title">Trayectoria literaria</h2>
      <div class="timeline-preview">
        {timeline.slice(-4).map((event) => (
          <div class="timeline-preview__item">
            <span class="timeline-preview__year">{event.year}</span>
            <div>
              <h3>{event.title}</h3>
              <p>{event.description}</p>
            </div>
          </div>
        ))}
      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href="/timeline" class="btn">Ver trayectoria completa</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: var(--header-height);
    background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
  }

  .hero__content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    padding: 3rem 0;
  }

  .hero__label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .hero__text h1 {
    font-size: 3.5rem;
    margin-bottom: 1.25rem;
  }

  .hero__subtitle {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    font-style: italic;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
  }

  .btn--outline {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .btn--outline:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: transparent;
  }

  .btn--sm {
    padding: 0.4rem 1rem;
    font-size: 0.8rem;
  }

  .hero__latest {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    padding: 2.5rem;
    border-radius: 4px;
  }

  .hero__latest-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-gold);
  }

  .hero__latest-title {
    font-size: 1.5rem;
    margin: 0.5rem 0 0.25rem;
  }

  .hero__latest-year {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .hero__latest-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .book-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    padding: 1.75rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s;
  }

  .book-card:hover {
    border-color: var(--color-accent);
  }

  .book-card__header {
    margin-bottom: 1rem;
  }

  .book-card__title {
    font-size: 1.2rem;
    margin-bottom: 0.25rem;
  }

  .book-card__sub {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .book-card__year {
    font-size: 0.8rem;
    color: var(--color-accent);
    font-family: var(--font-sans);
  }

  .book-card__desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    flex: 1;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .book-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .book-card__cat {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold);
  }

  .section--alt {
    background: var(--color-bg-alt);
  }

  .timeline-preview {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .timeline-preview__item {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1.5rem;
    padding: 1.25rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .timeline-preview__year {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-accent);
  }

  .timeline-preview__item h3 {
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }

  .timeline-preview__item p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .hero__content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero__text h1 {
      font-size: 2.5rem;
    }

    .timeline-preview__item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
