---
import IndexLayout from "@layouts/index-layout.astro"
import CardHero from "@components/index/card-hero.astro"
import GridNovedades from "@components/index/novedades/grid-novedades.astro"
import type { ImageMetadata } from "astro"
import { libros } from "@data/libros"
import type { Libro } from "@data/libros"

const portadas = import.meta.glob('/src/assets/images/portadas/*.png', { eager: true })
const fondos = import.meta.glob('/src/assets/images/fondos/*.jpg', { eager: true })

function getPortada(libro: Libro): ImageMetadata | undefined {
  if (!libro.portadaMini) return
  const key = `/src/assets/images/portadas/${libro.portadaMini}`
  return (portadas[key] as { default: ImageMetadata })?.default
}

function getFondo(libro: Libro): ImageMetadata | undefined {
  const key = `/src/assets/images/fondos/bg-${libro.id}.jpg`
  return (fondos[key] as { default: ImageMetadata })?.default
}

const novedades = [...libros].sort((a, b) => new Date(b.fechaAgregado).getTime() - new Date(a.fechaAgregado).getTime()).slice(0, 4)

const ultimaNovela = [...libros].filter((l) => l.categoria === "novela").sort((a, b) => b.ano - a.ano)[0]
---

<IndexLayout title="Daniel Jerez Torns — Escritor de novela negra, misterio y ciencia ficción">
  <section>
    {ultimaNovela && <CardHero libro={ultimaNovela} fondo={getFondo(ultimaNovela)} />}
  </section>

  <!-- Novedades -->
  <section>
    <GridNovedades libros={novedades.map(l => ({ libro: l, portada: getPortada(l) }))} />
  </section>

</IndexLayout>
