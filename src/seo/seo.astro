---
import { ClientRouter } from "astro:transitions"
import { SITE } from "@data/seo"

export interface Props {
  title: string
  description?: string
  image?: string
  url?: string
  type?: "website" | "article"
  keywords?: string
}

const { title, description, image, url, type, keywords } = Astro.props

const pageTitle = title
const pageDesc = description || SITE.description
const pageImage = image || SITE.defaultImage
const pageUrl = url || SITE.url
const pageType = type || "website"
const pageKeywords = keywords || "Daniel Jerez Torns, escritor, novela negra, misterio, intriga, libros, suspense, novela policiaca, literatura española, thriller, autopublicado, ficción, El canto del gallo, El pasado nunca nos olvida, El silencio de las ruinas, El beso de la muerte, La fórmula Terradas, El arcabucero nº 61, Al-iksir, Relatos tendidos, Grietas en el muro, El secreto del tesoro guardado, El Faraón y el prevencionista, Tres en raya, El mapa de la isla del estrés, Cada etapa su camino, narrativa, psicológica, cuentos, relatos, El Prat de Llobregat, Barcelona, cuentos adolescentes, cuentos adultos, cuentos infantiles, PRL, prevención de riesgos laborales, psicología, Yecla, Poble Nou"
---

<title>{pageTitle}</title>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={pageDesc} />
<meta name="keywords" content={pageKeywords} />
<meta name="robots" content="index, follow" />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={pageUrl} />

<link rel="shortcut icon" href="/favicon.ico" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicons/favicon-192.png" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicons/favicon-96.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicons/favicon-180.png" />
<link rel="mask-icon" href="/favicons/safari-pinned-tab.svg" color="#006837" />
<meta name="msapplication-config" content="/favicons/browserconfig.xml" />

<link rel="preload" href="/assets/fonts/inconsolata-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

<ClientRouter />

<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDesc} />
<meta property="og:image" content={pageUrl + pageImage} />
<meta property="og:url" content={pageUrl} />
<meta property="og:type" content={pageType} />
<meta property="og:site_name" content={SITE.title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDesc} />
<meta name="twitter:image" content={pageUrl + pageImage} />
